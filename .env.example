# Database Configuration
# Replace with your actual database connection string
# Examples:
# PostgreSQL: postgresql://username:password@host:port/database
# MySQL: mysql+pymysql://username:password@host:port/database  
# SQL Server: mssql+pyodbc://username:password@host:port/database?driver=ODBC+Driver+17+for+SQL+Server
# Oracle: oracle+cx_oracle://username:password@host:port/database
DATABASE_CONNECTION_STRING=your_database_connection_string_here

# Slack Configuration
# Get this from your Slack app's webhook settings
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional: Specify Slack channel (defaults to #finance-alerts)
SLACK_CHANNEL=#finance-alerts